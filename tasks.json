[
    {
        "label": "Pest (All Tests)",
        "command": "./vendor/bin/pest",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "NPM Dev",
        "command": "npm run dev",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "NPM Build",
        "command": "npm run build",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "NPM Install",
        "command": "npm install",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Composer Install",
        "command": "composer install",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Composer Update",
        "command": "composer update",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Composer Dump Autoload",
        "command": "composer dump-autoload",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "LazyGit",
        "command": "lazygit",
        "env": {},
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "always",
        "shell": "system",
    },
    {
        "label": "LazyGit log",
        "command": "lazygit",
        "args": ["log"],
        "env": {},
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "always",
        "shell": "system",
    },
    {
        "label": "Github PRs",
        "command": "gh",
        "args": ["dash"],
        "env": {},
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "always",
        "shell": "system",
    },
]
