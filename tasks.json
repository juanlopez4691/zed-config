[
    // Artisan
    {
        "label": "Artisan Serve",
        "command": "php artisan serve",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Migrate",
        "command": "sail artisan migrate",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Migrate Fresh",
        "command": "sail artisan migrate:fresh --seed",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Migrate Rollback",
        "command": "sail artisan migrate:rollback",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Tinker",
        "command": "sail artisan tinker",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Route List",
        "command": "sail artisan route:list",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Queue Work",
        "command": "sail artisan queue:work",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Make Controller",
        "command": "sail artisan make:controller ${1:ControllerName}",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Make Model",
        "command": "sail artisan make:model ${1:ModelName} -mf",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Artisan Cache Clear",
        "command": "sail artisan cache:clear && sail artisan config:clear && sail artisan route:clear && sail artisan view:clear",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    // Pint
    {
        "label": "Pint Format (All)",
        "command": "./vendor/bin/pint",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Pint Format (Dirty)",
        "command": "./vendor/bin/pint --dirty",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Pint Test",
        "command": "./vendor/bin/pint --test",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    // PHPUnit
    {
        "label": "PHPUnit (All Tests)",
        "command": "sail artisan test",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "PHPUnit (Current File)",
        "command": "sail artisan test ${ZED_FILE}",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "PHPUnit (Parallel)",
        "command": "sail artisan test --parallel",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "PHPUnit (Coverage)",
        "command": "sail artisan test --coverage",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    // Pest
    {
        "label": "Pest (All Tests)",
        "command": "./vendor/bin/pest",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    // NPM
    {
        "label": "NPM Dev",
        "command": "npm run dev",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "NPM Build",
        "command": "npm run build",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "NPM Install",
        "command": "npm install",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    // Composer
    {
        "label": "Composer Install",
        "command": "composer install",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Composer Update",
        "command": "composer update",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Composer Dump Autoload",
        "command": "composer dump-autoload",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
    },
    {
        "label": "Github PRs",
        "command": "gh",
        "args": ["dash"],
        "env": {},
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "always",
        "shell": "system",
    },
]
